{
  "name": "frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "sync": "svelte-kit sync",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "api": "openapi-ts",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:watch": "playwright test --watch"
  },
  "dependencies": {
    "@lucide/svelte": "^1.81.0",
    "@profidev/pleiades": "^1.14.1",
    "@sveltejs/enhanced-img": "1.0.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@msw/playwright": "0.7.0",
    "@playwright/test": "=1.64.1",
    "@sveltejs/adapter-node": "5.5.8",
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.11",
    "jsdom": "31.0.1",
    "msw": "3.0.8",
    "shadcn-svelte": "1.8.2",
    "svelte": "5.59.2",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
